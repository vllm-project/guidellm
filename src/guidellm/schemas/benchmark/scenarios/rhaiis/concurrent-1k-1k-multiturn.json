{
  "metadata": {
    "name": "concurrent-1k-1k-multiturn",
    "description": "Multi-turn conversation scenario with prefix caching.\n"
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "request_format": "/v1/chat/completions"
    },
    "profile": {
      "kind": "concurrent"
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 1000,
        "output_tokens": 1000,
        "turns": 5,
        "prefix_tokens": 512,
        "prefix_count": 10
      }
    ],
    "constraints": [
      {
        "kind": "max_duration",
        "seconds": 450
      }
    ]
  },
  "benchmarks": [
    {
      "profile.streams": 1
    },
    {
      "profile.streams": 25
    },
    {
      "profile.streams": 50
    },
    {
      "profile.streams": 75
    },
    {
      "profile.streams": 100
    }
  ]
}
