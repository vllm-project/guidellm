{
  "metadata": {
    "name": "concurrent-8k-800-norm",
    "description": "Large context scenario with sequence length variance.\n"
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "request_format": "/v1/chat/completions"
    },
    "profile": {
      "kind": "concurrent"
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 8000,
        "prompt_tokens_stdev": 8500,
        "prompt_tokens_min": 50,
        "prompt_tokens_max": 30000,
        "output_tokens": 800,
        "output_tokens_stdev": 1500,
        "output_tokens_min": 20,
        "output_tokens_max": 8000
      }
    ],
    "constraints": [
      {
        "kind": "max_duration",
        "seconds": 450
      }
    ]
  },
  "benchmarks": [
    {
      "profile.streams": 1
    },
    {
      "profile.streams": 50
    },
    {
      "profile.streams": 100
    },
    {
      "profile.streams": 200
    },
    {
      "profile.streams": 300
    }
  ]
}
